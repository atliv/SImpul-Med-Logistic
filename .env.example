# ==============================================================================
# Simpul Tech MedLogistics Engine — Environment Configuration
# ==============================================================================

# Neon PostgreSQL Connection URL (Supports both VITE_DATABASE_URL and DATABASE_URL)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
VITE_DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Force In-Memory Repository (Optional: set to "true" to bypass Postgres even if DATABASE_URL is set)
# Automated tests (Vitest) will ALWAYS use InMemoryWarehouseRepository regardless of this flag.
VITE_USE_IN_MEMORY=false
USE_IN_MEMORY=false
